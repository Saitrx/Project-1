  seed() {
    const s = this.project.settings;
    const spacing = Math.max(
      tierRadius(this.project.tiers[0]) * 2 + 6,
      s.feedSpeed * s.interval,
    );
    for (
      let i = 0;
      i < Math.min(9, this.valueBudget()) &&
      33 + i * spacing <
        s.chamberY + s.chamberRadius - tierRadius(this.project.tiers[0]);
