// Stable, disjoint matching. Never mutate a physics world inside a contact callback.
export function selectMerges<
  T extends { id: number; tier: number; readyAt: number },
>(pairs: [T, T][], now: number, lastTier: number): [T, T][] {
  const used = new Set<number>(),
    result: [T, T][] = [];
  pairs.sort((a, b) => Math.min(a[0].id, a[1].id) - Math.min(b[0].id, b[1].id));
  for (const [a, b] of pairs)
    if (
      a.tier === b.tier &&
      a.tier < lastTier &&
      a.readyAt <= now &&
      b.readyAt <= now &&
      !used.has(a.id) &&
      !used.has(b.id)
    ) {
      used.add(a.id);
      used.add(b.id);
      result.push([a, b]);
    }
  return result;
}

import { projectInside, wallClearance } from "./boundary";
import { World, Vec2, Chain, Circle, Body, Contact } from "planck";
import { Project, PX, STEP, tierRadius } from "./config";
import { selectMerges } from "./merges";
export interface Orb {
  id: number;
  tier: number;
  body: Body;
  radius: number;
  targetRadius: number;
  feed: boolean;
  readyAt: number;
  born: number;
  previous: { x: number; y: number };
  previousAngle: number;
  growthRate: number;
  wallHitAt: number;
}
export interface SimEvent {
  kind: "collision" | "wall" | "merge" | "spawn";
  a: number;
  b?: number;
  speed: number;
  x: number;
  y: number;
  radius: number;
  pair: string;
  orbIds?: number[];
  normal?: { x: number; y: number };
}
export function boundary(p: Project) {
  const s = p.settings,
    theta = Math.asin(s.chuteWidth / 2 / s.chamberRadius),
    a = -Math.PI / 2 + theta,
    b = (3 * Math.PI) / 2 - theta;
  const out = [{ x: s.chamberX + s.chuteWidth / 2, y: -600 }];
  for (let i = 0; i <= 240; i++) {
    const t = a + ((b - a) * i) / 240;
    out.push({
      x: s.chamberX + Math.cos(t) * s.chamberRadius,
      y: s.chamberY + Math.sin(t) * s.chamberRadius,
    });
  }
  out.push({ x: s.chamberX - s.chuteWidth / 2, y: -600 });
  return out;
}
export class Simulation {
  world: World;
  orbs = new Map<number, Orb>();
  time = 0;
  spawnClock = 0;
  nextId = 1;
  spawnIndex = 0;
  mergeCount = 0;
  spawnBlocked = false;
  events: SimEvent[] = [];
  private begins: {
    a: Orb;
    b?: Orb;
    speed: number;
    normal: { x: number; y: number };
  }[] = [];
  constructor(
    public project: Project,
    seed = true,
  ) {
    this.world = new World(Vec2(0, project.settings.gravity / PX));
    const wall = this.world.createBody();
    wall.createFixture(
      new Chain(
        boundary(project).map((p) => Vec2(p.x / PX, p.y / PX)),
        false,
      ),
      {
        friction: project.settings.friction,
        restitution: project.settings.wallBounce,
      },
    );
    this.world.on("begin-contact", (c) => this.contact(c));
    this.world.on("pre-solve", (c) => {
      const isWall =
        !c.getFixtureA().getBody().getUserData() ||
        !c.getFixtureB().getBody().getUserData();
