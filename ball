import assert from "node:assert/strict";
import { defaults, validate, tierRadius, PX } from "../src/config";
import { Simulation } from "../src/physics";
let passed = 0;
function check(name: string, run: () => void) {
  run();
  passed++;
  console.log(`PASS ${name}`);
}
check(
  "Legacy visual scales migrate without changing artwork or hitboxes",
  () => {
    const p: any = defaults();
    for (const t of p.tiers) {
      t.scale = t.imageFit;
      delete t.imageFit;
    }
    delete p.settings.rotateSprites;
    delete p.settings.angularDamping;
    const before = p.tiers.map((t: any) => ({
      r: t.radius,
      image: t.radius * 2 * t.scale,
    }));
    validate(p);
    validate(p);
    p.tiers.forEach((t: any, i: number) => {
      assert.equal(tierRadius(t), before[i].r);
      assert.equal(tierRadius(t) * 2 * t.imageFit, before[i].image);
    });
    assert.equal(p.settings.rotateSprites, true);
  },
);
check(
  "Increasing and decreasing picture size changes actual collider radii proportionally",
  () => {
    for (const scale of [0.5, 1, 1.5]) {
      const p = defaults();
      p.tiers[0].scale = scale;
      validate(p);
      const s = new Simulation(p, false),
        o = s.add(0, 360, 586);
      assert.equal(o.radius, 28 * scale);
      assert.equal(o.targetRadius, 28 * scale);
      assert(
        Math.abs(
          (o.body.getFixtureList()!.getShape() as any).m_radius * PX -
            28 * scale,
        ) < 1e-8,
      );
      assert.equal(o.radius * 2 * p.tiers[0].imageFit, 56 * scale * 1.16);
    }
  },
);
check(
  "A resized first tier reserves feed clearance and respects the open chute",
  () => {
    const p = defaults();
    p.tiers[0].scale = 2;
    const s = new Simulation(validate(p));
    const orbs = [...s.orbs.values()];
    assert(orbs[1].previous.y - orbs[0].previous.y >= 118);
    for (let i = 0; i < 1200; i++) {
      s.step();
      for (const o of s.orbs.values())
        assert(Number.isFinite(o.body.getAngle()));
    }
  },
);
check("Invalid resized hitboxes are rejected before applying a project", () => {
  for (const [tier, scale] of [
    [0, 3],
    [6, 2],
    [0, 0.25],
  ]) {
    const p = defaults();
    p.tiers[tier].scale = scale;
    assert.throws(() => validate(p));
  }
});
check(
  "Scaled successors grow to the scaled tier's collider and maintain correct inertia",
  () => {
    const p = defaults();
    p.settings.gravity = 0;
    p.tiers[1].scale = 1.5;
    const s = new Simulation(p, false);
    s.add(0, 333, 586);
    s.add(0, 387, 586);
    for (let i = 0; i < 60; i++) s.step(false);
    const o = [...s.orbs.values()][0];
    assert.equal(o.tier, 1);
    assert.equal(o.radius, 63);
    assert(
      Math.abs(o.body.getInertia() - (o.body.getMass() * (63 / PX) ** 2) / 2) <
        1e-8,
    );
  },
);
check(
  "Glancing wall contact produces physical rotation and rotation interpolates from the previous step",
  () => {
    const p = defaults();
    p.settings.gravity = 0;
    const s = new Simulation(p, false),
      o = s.add(1, 660, 586, 200, 180);
    let max = 0;
    for (let i = 0; i < 120; i++) {
      const angle = o.body.getAngle();
      s.step(false);
      assert(
        Math.abs(
          Math.atan2(
            Math.sin(o.previousAngle - angle),
            Math.cos(o.previousAngle - angle),
          ),
        ) < 1e-9,
      );
      max = Math.max(max, Math.abs(o.body.getAngularVelocity()));
    }
    assert(max > 0.05);
    assert(Math.abs(o.body.getAngle()) > 0.02);
  },
);
check(
  "Merges carry angular momentum; growth does not create extra spin",
  () => {
    const p = defaults();
    p.settings.gravity = 0;
    p.settings.angularDamping = 0;
    p.settings.friction = 0;
    const s = new Simulation(p, false);
    const a = s.add(0, 333, 586),
      b = s.add(0, 387, 586);
    a.body.setAngularVelocity(1);
    b.body.setAngularVelocity(1);
    const momentum = a.body.getInertia() + b.body.getInertia();
    s.step(false);
    const o = [...s.orbs.values()][0];
    assert.equal(o.tier, 1);
    assert(
      Math.abs(o.body.getInertia() * o.body.getAngularVelocity() - momentum) <
        1e-8,
    );
    for (let i = 0; i < 60; i++) s.step(false);
    assert(
      Math.abs(o.body.getInertia() * o.body.getAngularVelocity() - momentum) <
        1e-8,
    );
  },
);
check("Untouched feed stays unspun and spin damping applies live", () => {
  const s = new Simulation(defaults(), false),
    o = s.add(0, 360, 0, 0, 260, true);
  for (let i = 0; i < 30; i++) s.step(false);
  assert.equal(o.body.getAngle(), 0);
  s.project.settings.angularDamping = 2;
  s.applyLive();
  assert.equal(o.body.getAngularDamping(), 2);
});
console.log(`${passed} rotation and size checks passed.`);

