import { Project } from "./config";
import { validateVideo, VideoSettings } from "./video-settings";
import type { VideoResult } from "./video";

export class VideoEditor {
  private root?: HTMLElement;
  private controller?: AbortController;
  private url = "";
  private result?: VideoResult;
  private message = "Ready to render. No live recording needed.";
  private fraction = 0;
  private error = false;
  constructor(
    private project: () => Project,
    private change: (v: VideoSettings) => void,
    private busy: (value: boolean) => void,
  ) {
    window.addEventListener("beforeunload", (e) => {
      if (this.controller) {
        e.preventDefault();
        e.returnValue = "";
      }
    });
    void import("./video")
      .then((m) => m.savedVideo())
      .then((saved) => {
        if (saved && !this.controller && !this.result) {
          this.result = saved.result;
          this.url = URL.createObjectURL(saved.blob);
          this.update();
        }
      });
  }
  mount(root: HTMLElement) {
    this.root = root;
    const v = this.project().video;
    const select = (
      key: keyof VideoSettings,
      label: string,
      values: (string | number)[],
      labels = values.map(String),
    ) =>
      `<label>${label}<select data-video="${key}" aria-label="${label}">${values.map((value, i) => `<option value="${value}" ${v[key] === value ? "selected" : ""}>${labels[i]}</option>`).join("")}</select></label>`;
    root.innerHTML = `<details open class="video-project"><summary><span>↧</span> Finish a video <b>Frame by frame</b></summary><div class="section">
      <p class="hint">Set up your pictures, sounds and physics, then finish your video. A fresh run renders from the beginning. A slower PC takes longer; it does not skip frames.</p>
      <fieldset class="video-options"><div class="two">
      ${select("width", "Video resolution", [540, 720, 1080, 1440, 2160], ["540 × 960", "720 × 1280 · HD", "1080 × 1920 · Full HD", "1440 × 2560 · QHD", "2160 × 3840 · 4K"])}
      ${select("fps", "Video frame rate", [24, 30, 60], ["24 FPS", "30 FPS", "60 FPS"])}
      <label>Duration (seconds)<input type="number" data-video="seconds" aria-label="Video duration" min="1" max="300" step="1" value="${v.seconds}"></label>
      ${select("quality", "Video quality", ["standard", "high", "ultra"], ["Standard", "High", "Ultra · larger file"])}
      ${select("format", "Video format", ["mp4", "webm"], ["MP4 · H.264", "WebM · VP9"])}
      </div><label class="check"><input type="checkbox" data-video="audio" ${v.audio ? "checked" : ""}> Include game sounds</label></fieldset>
      <p class="hint">Uses applied settings, including sound volumes and mute. Apply pending size or geometry changes first. Video options save with your project. Output contains only the 9:16 scene.</p>
      <button id="finish-video" class="primary full">Finish & save video</button><button id="cancel-video" class="full" hidden>Cancel render</button>
      <progress id="video-progress" max="1" value="0" hidden></progress><p id="video-status" role="status" class="hint"></p>
      <a id="download-video" class="video-download" hidden>↓ Download finished video</a>
      <p class="hint">Keep this page open until complete. The finished file downloads and stays available here after reload. Export project below to back up your editable setup and assets. 4K requires a compatible encoder; original image detail still depends on your uploads.</p>
      </div></details>`;
    root
      .querySelectorAll<HTMLInputElement | HTMLSelectElement>("[data-video]")
      .forEach((el) => {
        el.addEventListener("change", () => {
          const key = el.dataset.video! as keyof VideoSettings;
          const value =
            key === "audio"
              ? (el as HTMLInputElement).checked
              : ["width", "fps", "seconds"].includes(key)
                ? Number(el.value)
                : el.value;
          const next = { ...this.project().video, [key]: value };
          try {
            validateVideo(next);
            this.change(next);
            this.error = false;
            this.message = "Video settings saved with your project.";
          } catch (e) {
            this.error = true;
            this.message = (e as Error).message;
            el.value = String(this.project().video[key]);
          }
          this.update();
        });
      });
    root
      .querySelector("#finish-video")!
      .addEventListener("click", () => void this.finish());
    root.querySelector("#cancel-video")!.addEventListener("click", () => {
      this.controller?.abort();
      this.message = "Cancelling render…";
      this.update();
    });
    this.update();
  }
  private update() {
    if (!this.root) return;
    const active = !!this.controller;
    this.root.querySelector<HTMLFieldSetElement>("fieldset")!.disabled = active;
    this.root.querySelector<HTMLButtonElement>("#finish-video")!.disabled =
      active;
    this.root.querySelector<HTMLButtonElement>("#cancel-video")!.hidden =
      !active;
    const bar = this.root.querySelector<HTMLProgressElement>("progress")!;
    bar.hidden = !active;
    bar.value = this.fraction;
    const status = this.root.querySelector<HTMLElement>("#video-status")!;
    status.textContent = this.message;
    status.classList.toggle("error", this.error);
    const link = this.root.querySelector<HTMLAnchorElement>("#download-video")!;
    link.hidden = !this.result;
    if (this.result) {
      link.href = this.url;
      link.download = this.result.name;
      link.textContent = `↓ Download ${this.result.width} × ${this.result.height} · ${this.result.fps} FPS · ${(this.result.bytes / 1048576).toFixed(1)} MB`;
    }
  }
  private async finish() {
    if (this.controller) return;
    const snapshot = structuredClone(this.project());
    this.controller = new AbortController();
    this.error = false;
    this.fraction = 0;
    this.message = "Preparing your video…";
    this.busy(true);
    this.update();
    const began = performance.now();
    let lastUpdate = 0;
    try {
      const { renderVideo } = await import("./video");
      const saved = await renderVideo(
        snapshot,
        this.controller.signal,
        (frame, total, phase) => {
          if (performance.now() - lastUpdate < 150 && frame !== total) return;
          lastUpdate = performance.now();
          this.fraction = frame / total;
          const elapsed = (performance.now() - began) / 1000;
          const remaining =
            frame > 10 ? Math.ceil((elapsed * (total - frame)) / frame) : 0;
          this.message = `${phase} ${frame.toLocaleString()} / ${total.toLocaleString()} frames · ${Math.round(this.fraction * 100)}%${remaining ? ` · about ${remaining}s remaining` : ""}`;
          this.update();
        },
      );
      if (this.url) URL.revokeObjectURL(this.url);
      this.url = URL.createObjectURL(saved.blob);
      this.result = saved.result;
      this.message = `Finished: ${saved.result.frames.toLocaleString()} frames, ${saved.result.seconds}s. Saved on this device. Your preview is paused; press Resume to continue.`;
      this.update();
      this.root?.querySelector<HTMLAnchorElement>("#download-video")?.click();
    } catch (e) {
      this.error = !this.controller.signal.aborted;
      this.message = this.error
        ? `Could not finish: ${(e as Error).message}`
        : "Render cancelled. Your project and previous finished video are safe.";
    } finally {
      this.controller = undefined;
      this.busy(false);
      this.update();
    }
  }
}

export interface VideoSettings {
  width: number;
  fps: number;
  seconds: number;
  quality: "standard" | "high" | "ultra";
  format: "mp4" | "webm";
  audio: boolean;
}
export const videoDefaults = (): VideoSettings => ({
  width: 1080,
  fps: 60,
  seconds: 30,
  quality: "high",
  format: "mp4",
  audio: true,
});
export function validateVideo(v: VideoSettings) {
  if (
    !v ||
    ![540, 720, 1080, 1440, 2160].includes(v.width) ||
    ![24, 30, 60].includes(v.fps) ||
    !Number.isInteger(v.seconds) ||
    v.seconds < 1 ||
    v.seconds > 300 ||
    !["standard", "high", "ultra"].includes(v.quality) ||
    !["mp4", "webm"].includes(v.format) ||
    typeof v.audio !== "boolean"
  )
    throw Error(
      "Invalid video settings. Choose a supported resolution, 24/30/60 FPS and 1–300 whole seconds.",
    );
  return v;
}

import {
  AudioBufferSource,
  CanvasSource,
  Output,
  Mp4OutputFormat,
  WebMOutputFormat,
  StreamTarget,
  Quality,
  canEncodeVideo,
  canEncodeAudio,
} from "mediabunny";
import { Project, STEP, validate } from "./config";
import { AssetLibrary } from "./assets";
import { SoundEngine, selectSound } from "./audio";
import { Simulation, SimEvent } from "./physics";
import { Renderer } from "./render";

const LAST_VIDEO = "merge-chamber-last-video";
export interface VideoResult {
  file: string;
  name: string;
  width: number;
  height: number;
  fps: number;
  seconds: number;
  frames: number;
  audio: boolean;
  bytes: number;
}
export async function savedVideo(): Promise<{
  result: VideoResult;
  blob: File;
} | null> {
  try {
    const result: VideoResult = JSON.parse(
      localStorage.getItem(LAST_VIDEO) || "null",
    );
    if (!result || !/^render-[\w.-]+$/.test(result.file)) return null;
    const root = await navigator.storage.getDirectory();
    const blob = await (await root.getFileHandle(result.file)).getFile();
    return { result, blob };
  } catch {
    return null;
  }
}

// Mix one second at a time. Long projects do not allocate minutes of raw PCM.
export class VideoAudio {
  private last = new Map<string, number>();
  private notes: {
    start: number;
    end: number;
    gain: number;
    buffer: AudioBuffer;
  }[] = [];
  private ends: number[] = [];
  cursor = 0;
  scheduled = 0;
  constructor(
    private project: Project,
    private buffers: Map<string, AudioBuffer>,
    private source: AudioBufferSource,
  ) {}
  event(e: SimEvent, simulationTime: number) {
    const sound = selectSound(e, this.project, simulationTime, this.last);
    if (!sound || this.project.settings.muted) return;
    const buffer = this.buffers.get(sound.key),
      start = simulationTime / this.project.settings.speed;
    this.ends = this.ends.filter((end) => end > start);
    if (!buffer || this.ends.length >= this.project.settings.voices) return;
    const end = start + buffer.duration;
    this.ends.push(end);
    this.notes.push({
      start,
      end,
      buffer,
      gain: Math.min(1, sound.volume * this.project.settings.master),
    });
    this.scheduled++;
  }
  async flush(until: number) {
    const rate = 48000;
    const endSample = Math.round(until * rate),
      startSample = Math.round(this.cursor * rate);
    if (endSample <= startSample) return;
    const result = new AudioBuffer({
      numberOfChannels: 2,
      length: endSample - startSample,
      sampleRate: rate,
    });
    for (const note of this.notes) {
      const begin = Math.max(startSample, Math.ceil(note.start * rate));
      const end = Math.min(endSample, Math.ceil(note.end * rate));
      for (let channel = 0; channel < 2; channel++) {
        const dest = result.getChannelData(channel);
        const src = note.buffer.getChannelData(
          Math.min(channel, note.buffer.numberOfChannels - 1),
        );
        for (let n = begin; n < end; n++) {
          const at = (n / rate - note.start) * note.buffer.sampleRate;
          const i = Math.floor(at),
            frac = at - i;
          dest[n - startSample] +=
            ((src[i] || 0) * (1 - frac) + (src[i + 1] || 0) * frac) * note.gain;
        }
      }
    }
    // Match output saturation without introducing automatic volume pumping.
    for (let channel = 0; channel < 2; channel++) {
      const data = result.getChannelData(channel);
      for (let i = 0; i < data.length; i++)
        data[i] = Math.max(-1, Math.min(1, data[i]));
    }
    await this.source.add(result);
    this.cursor = endSample / rate;
    this.notes = this.notes.filter((n) => n.end > this.cursor);
  }
}

export async function renderVideo(
  project: Project,
  signal: AbortSignal,
  progress: (
    frame: number,
    total: number,
    phase: string,
  ) => void | Promise<void>,
) {
  const p = validate(structuredClone(project)),
    v = p.video;
  const width = v.width,
    height = (width * 16) / 9,
    total = v.seconds * v.fps;
  const codec = v.format === "mp4" ? "avc" : "vp9";
  const audioCodec = v.format === "mp4" ? "aac" : "opus";
  const bitrate = Math.round(
    width *
      height *
      v.fps *
      { standard: 0.1, high: 0.2, ultra: 0.35 }[v.quality],
  );
  const quality = new Quality({ bitrate });
  const check = () => signal.throwIfAborted();
  check();
  await progress(0, total, "Checking encoder and loading project…");
  if (
    !(await canEncodeVideo(codec, {
      width,
      height,
      frameRate: v.fps,
      quality,
      latencyMode: "quality",
    }))
  )
    throw Error(
      `${v.format.toUpperCase()} at ${width} × ${height} / ${v.fps} FPS is unavailable in this browser. Try WebM or another resolution. No quality was reduced automatically.`,
    );
  if (
    v.audio &&
    !(await canEncodeAudio(audioCodec, {
      sampleRate: 48000,
      numberOfChannels: 2,
    }))
  )
    throw Error(
      "This browser cannot encode audio in this format. Try WebM, or turn off Include sound.",
    );
  if (!navigator.storage?.getDirectory)
    throw Error(
      "Video export needs local file storage. Open this app at localhost in a current Chrome or Edge browser.",
    );
  const root = await navigator.storage.getDirectory();
  const old = await savedVideo();
  const file = `render-${crypto.randomUUID()}.${v.format}`;
  const handle = await root.getFileHandle(file, { create: true });
  let output: Output | undefined,
    writable: FileSystemWritableFileStream | undefined;
  const assets = new AssetLibrary(),
    sound = new SoundEngine();
  try {
    await assets.preload(p);
    if (v.audio) await sound.init(p);
    check();
    writable = await handle.createWritable();
    const sink = writable;
    output = new Output({
      format:
        v.format === "mp4"
          ? new Mp4OutputFormat({ fastStart: "fragmented" })
          : new WebMOutputFormat(),
      target: new StreamTarget(
        new WritableStream({
          write: (chunk) => sink.write(chunk),
          close: () => sink.close(),
          abort: (reason) => sink.abort(reason),
        }),
        { chunked: true, chunkSize: 1024 * 1024 },
      ),
    });
    const canvas = document.createElement("canvas"),
      renderer = new Renderer(canvas, assets, width);
    const video = new CanvasSource(canvas, {
      codec,
      quality,
      latencyMode: "quality",
      keyFrameInterval: 2,
    });
    output.addVideoTrack(video, { frameRate: v.fps });
    let mixer: VideoAudio | undefined;
    if (v.audio) {
      const source = new AudioBufferSource({
        codec: audioCodec,
        quality: new Quality({ bitrate: 192000 }),
      });
      output.addAudioTrack(source);
      mixer = new VideoAudio(p, sound.buffers, source);
    }
    await output.start();
    const sim = new Simulation(p);
    let steps = 0;
    const advance = (seconds: number) => {
      const target = Math.floor((seconds * p.settings.speed) / STEP + 1e-7);
      while (steps < target) {
        sim.step();
        steps++;
        for (const e of sim.events) {
          renderer.event(e, sim.time);
          mixer?.event(e, sim.time);
        }
      }
      return (seconds * p.settings.speed) / STEP - target;
    };
    for (let frame = 0; frame < total; frame++) {
      check();
      const seconds = frame / v.fps;
      const fraction = advance(seconds);
      // The live canvas uses the same one-step interpolation delay.
      renderer.draw(sim, Math.max(0, Math.min(1, fraction)));
      await video.add(seconds, 1 / v.fps);
      if (mixer && seconds >= mixer.cursor + 1)
        await mixer.flush(mixer.cursor + 1);
      await progress(frame + 1, total, "Rendering every frame…");
      // Yield independently of requestAnimationFrame: hidden tabs can finish too.
      if (frame % 4 === 0)
        await new Promise((resolve) => setTimeout(resolve, 0));
    }
    advance(v.seconds);
    if (mixer) await mixer.flush(v.seconds);
    check();
    await progress(total, total, "Finishing video file…");
    await output.finalize();
    check();
    const blob = await handle.getFile();
    const result: VideoResult = {
      file,
      name: `merge-chamber-${width}x${height}-${v.fps}fps.${v.format}`,
      width,
      height,
      fps: v.fps,
      seconds: v.seconds,
      frames: total,
      audio: v.audio,
      bytes: blob.size,
    };
    localStorage.setItem(LAST_VIDEO, JSON.stringify(result));
    if (old && old.result.file !== file)
      await root.removeEntry(old.result.file).catch(() => {});
    return {
      result,
      blob,
      simulation: sim.snapshot(),
      audioEvents: mixer?.scheduled ?? 0,
    };
  } catch (error) {
    await output?.cancel().catch(() => {});
    await writable?.abort().catch(() => {});
    await root.removeEntry(file).catch(() => {});
    throw error;
  } finally {
    assets.clear();
    await sound.context?.close().catch(() => {});
  }
}

