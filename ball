            Vec2(
              pa.x - ((dx / d) * correction * mb) / (ma + mb) / PX,
              pa.y - ((dy / d) * correction * mb) / (ma + mb) / PX,
            ),
            a.body.getAngle(),
          );
          b.body.setTransform(
            Vec2(
              pb.x + ((dx / d) * correction * ma) / (ma + mb) / PX,
              pb.y + ((dy / d) * correction * ma) / (ma + mb) / PX,
            ),
            b.body.getAngle(),
          );
          this.contain(a);
          this.contain(b);
          if (this.orbs.size > 50) {
            const va = a.body.getLinearVelocity(),
              vb = b.body.getLinearVelocity(),
              closing = ((vb.x - va.x) * dx) / d + ((vb.y - va.y) * dy) / d;
            if (closing < 0) {
              const impulse = -closing / (1 / ma + 1 / mb);
              a.body.setLinearVelocity(
                Vec2(
                  va.x - (impulse * dx) / d / ma,
                  va.y - (impulse * dy) / d / ma,
                ),
              );
              b.body.setLinearVelocity(
                Vec2(
                  vb.x + (impulse * dx) / d / mb,
                  vb.y + (impulse * dy) / d / mb,
                ),
              );
            }
          }
        }
      }
    for (const o of this.orbs.values()) {
      this.contain(o, true);
      this.limitSpin(o, true);
    }
  }
  private merge(a: Orb, b: Orb) {
    const pa = a.body.getPosition(),
      pb = b.body.getPosition(),
      va = a.body.getLinearVelocity(),
      vb = b.body.getLinearVelocity(),
      ma = a.body.getMass(),
      mb = b.body.getMass();
    const x = ((pa.x * ma + pb.x * mb) / (ma + mb)) * PX,
      y = ((pa.y * ma + pb.y * mb) / (ma + mb)) * PX,
      vx = ((va.x * ma + vb.x * mb) / (ma + mb)) * PX,
      vy = ((va.y * ma + vb.y * mb) / (ma + mb)) * PX;
    const angularMomentum =
      a.body.getInertia() * a.body.getAngularVelocity() +
      b.body.getInertia() * b.body.getAngularVelocity() +
      ma *
        ((pa.x - x / PX) * (va.y - vy / PX) -
          (pa.y - y / PX) * (va.x - vx / PX)) +
      mb *
        ((pb.x - x / PX) * (vb.y - vy / PX) -
          (pb.y - y / PX) * (vb.x - vx / PX));
    this.orbs.delete(a.id);
    this.orbs.delete(b.id);
    this.world.destroyBody(a.body);
    this.world.destroyBody(b.body);
    const tier = a.tier + 1,
      r = tierRadius(this.project.tiers[tier]);
    const o = this.add(
      tier,
      x,
      y,
      vx,
      vy,
      false,
      Math.min(r, Math.max(a.radius, b.radius)),
    );
    o.readyAt = this.time + 0.12;
    // Carry rotation through a merge, with a safety limit for extreme custom setups.
    o.body.setAngularVelocity(angularMomentum / o.body.getInertia());
    this.limitSpin(o);
    this.contain(o);
    this.mergeCount++;
    this.events.push({
      kind: "merge",
      a: tier,
      speed: Math.hypot(vx, vy),
      x,
      y,
      radius: r,
      pair: `merge:${o.id}`,
      orbIds: [o.id],
      normal: { x: pb.x - pa.x, y: pb.y - pa.y },
    });
  }
  private grow() {
    const list = [...this.orbs.values()],
      rates = new Map<number, number>(),
      s = this.project.settings;
    for (const o of list) {
      if (o.radius >= o.targetRadius) continue;
      const dr = Math.min(o.targetRadius - o.radius, o.growthRate * STEP);
      o.radius += dr;
      rates.set(
        o.id,
        Math.min(
          250,
          (dr / STEP) * s.expansionBounce * Math.min(1, o.targetRadius / 118),
        ),
      );
      (o.body.getFixtureList()!.getShape() as Circle).m_radius = o.radius / PX;
      const angularMomentum = o.body.getInertia() * o.body.getAngularVelocity();
      const mass = o.body.getMass(),
        inertia = (mass * (o.radius / PX) ** 2) / 2;
      o.body.setMassData({ mass, center: Vec2(), I: inertia });
      o.body.setAngularVelocity(angularMomentum / inertia);
      o.body.setTransform(o.body.getPosition(), o.body.getAngle());
      o.body.setAwake(true);
    }
    if (!rates.size || !s.expansionBounce) return;
    // An expanding surface has a normal speed even when its center is still.
    // Resolve that speed at actual contacts, conserving pair momentum. There
    // is no launch impulse in free space or when a merge has no growth.
    for (let i = 0; i < list.length; i++) {
      const a = list[i],
        rate = rates.get(a.id) || 0,
        pa = a.body.getPosition();
      if (rate) {
        const wall = wallClearance(s, pa.x * PX, pa.y * PX);
        const normal =
          wall.distance <= a.radius + 1
            ? { x: -wall.ix, y: -wall.iy }
            : undefined;
        if (normal) {
          const nx = normal.x,
            ny = normal.y,
            v = a.body.getLinearVelocity();
          const approaching = (v.x * nx + v.y * ny) * PX + rate;
          if (approaching > 0)
            a.body.setLinearVelocity(
              Vec2(
                v.x - ((1 + s.wallBounce) * approaching * nx) / PX,
                v.y - ((1 + s.wallBounce) * approaching * ny) / PX,
              ),
            );
        }
      }
      for (let j = i + 1; j < list.length; j++) {
        const b = list[j],
          surfaceSpeed = rate + (rates.get(b.id) || 0);
        if (!surfaceSpeed) continue;
        const pb = b.body.getPosition(),
          dx = (pb.x - pa.x) * PX,
          dy = (pb.y - pa.y) * PX,
          d = Math.hypot(dx, dy);
        if (d < 0.01 || d > a.radius + b.radius + 1) continue;
        const nx = dx / d,
          ny = dy / d,
          va = a.body.getLinearVelocity(),
          vb = b.body.getLinearVelocity();
        const approaching =
          surfaceSpeed - ((vb.x - va.x) * nx + (vb.y - va.y) * ny) * PX;
        if (approaching <= 0) continue;
        const ma = a.body.getMass(),
          mb = b.body.getMass(),
          impulse = ((1 + s.bounce) * approaching) / PX / (1 / ma + 1 / mb);
        a.body.setLinearVelocity(
          Vec2(va.x - (impulse * nx) / ma, va.y - (impulse * ny) / ma),
        );
        b.body.setLinearVelocity(
          Vec2(vb.x + (impulse * nx) / mb, vb.y + (impulse * ny) / mb),
        );
        for (const o of [a, b])
          if (o.feed) {
            o.feed = false;
            o.body.setGravityScale(1);
            o.body.setLinearDamping(s.damping);
          }
      }
    }
  }
  private spinLimit(o: Orb) {
    return (
      ((this.project.settings.maxSpin * Math.PI) / 180) *
      Math.max(0.6, Math.min(1.2, Math.sqrt(68 / o.targetRadius)))
    );
  }
  private limitSpin(o: Orb, correctAngle = false) {
    const limit = this.spinLimit(o),
      w = o.body.getAngularVelocity();
    if (Math.abs(w) > limit) o.body.setAngularVelocity(Math.sign(w) * limit);
    // Collision impulses are solved before Planck integrates angles. Bound that
    // same step too, so one fast impact cannot leave a one-frame visual snap.
    if (correctAngle) {
      const raw = o.body.getAngle() - o.previousAngle;
      // Planck normalizes angles during CCD and setTransform. Compare equivalent
      // orientations instead of interpreting a full-turn wrap as an impact spin.
      let delta = Math.atan2(Math.sin(raw), Math.cos(raw));
      if (Math.abs(delta) > limit * STEP) {
        delta = Math.sign(delta) * limit * STEP;
        o.body.setTransform(o.body.getPosition(), o.previousAngle + delta);
      }
      // Keep interpolation in the same angular interval as the current body.
      o.previousAngle = o.body.getAngle() - delta;
    }
  }
  contain(o: Orb, rebound = false) {
    const s = this.project.settings,
      p = o.body.getPosition();
    const x = p.x * PX,
      y = p.y * PX;
    const projected = projectInside(s, x, y, o.radius);
    const nx = projected.x,
      ny = projected.y;
    if (Math.hypot(nx - x, ny - y) > 1e-7) {
      // Let Planck's contact skin handle ordinary hits. The emergency projection
      // only reflects outward motion, so an engine rebound is never doubled.
      const distance = Math.hypot(x - nx, y - ny),
        normal = Vec2((x - nx) / distance, (y - ny) / distance);
      const v = o.body.getLinearVelocity(),
        outward = v.x * normal.x + v.y * normal.y;
      if (outward > 0) {
        const restitution = rebound && outward * PX > 50 ? s.wallBounce : 0;
        const mass = o.body.getMass(),
          inertia = o.body.getInertia(),
          radius = o.radius / PX;
        const tangent = Vec2(-normal.y, normal.x);
        const sliding =
          v.x * tangent.x +
          v.y * tangent.y +
          o.body.getAngularVelocity() * radius;
        const frictionLimit = s.friction * mass * (1 + restitution) * outward;
        const frictionImpulse = Math.max(
          -frictionLimit,
          Math.min(
            frictionLimit,
            -sliding / (1 / mass + (radius * radius) / inertia),
          ),
        );
        o.body.setLinearVelocity(
          Vec2(
            v.x -
              (1 + restitution) * outward * normal.x +
              (frictionImpulse * tangent.x) / mass,
            v.y -
              (1 + restitution) * outward * normal.y +
              (frictionImpulse * tangent.y) / mass,
          ),
        );
        o.body.setAngularVelocity(
          o.body.getAngularVelocity() + (radius * frictionImpulse) / inertia,
        );
        if (
          rebound &&
          outward * PX > 12 &&
          this.time - o.wallHitAt >= 0.09 &&
          !this.events.some(
            (e) => e.kind === "wall" && e.orbIds?.includes(o.id),
          )
        ) {
          o.wallHitAt = this.time;
          this.events.push({
            kind: "wall",
            a: o.tier,
            speed: outward * PX,
            x: nx,
            y: ny,
            radius: o.radius,
            pair: `wall:${o.id}`,
            orbIds: [o.id],
            normal,
          });
        }
      }
      o.body.setTransform(Vec2(nx / PX, ny / PX), o.body.getAngle());
    }
  }
  relax(iterations = 8) {
    const list = [...this.orbs.values()];
    for (let k = 0; k < iterations; k++) {
      for (let i = 0; i < list.length; i++)
        for (let j = i + 1; j < list.length; j++) {
          const a = list[i],
            b = list[j],
            pa = a.body.getPosition(),
            pb = b.body.getPosition();
          let dx = (pb.x - pa.x) * PX,
            dy = (pb.y - pa.y) * PX,
            d = Math.hypot(dx, dy),
            over = a.radius + b.radius - d;
          if (over > 0.3) {
            if (d < 0.01) {
              dx = a.id % 2 ? 1 : -1;
              dy = 0;
              d = 1;
            }
            const shift = Math.min(over * 0.52, 8),
              ma = a.body.getMass(),
              mb = b.body.getMass();
            a.body.setTransform(
              Vec2(
                pa.x - ((dx / d) * shift * mb) / (ma + mb) / PX,
                pa.y - ((dy / d) * shift * mb) / (ma + mb) / PX,
              ),
              a.body.getAngle(),
            );
            b.body.setTransform(
              Vec2(
                pb.x + ((dx / d) * shift * ma) / (ma + mb) / PX,
                pb.y + ((dy / d) * shift * ma) / (ma + mb) / PX,
              ),
              b.body.getAngle(),
            );
            a.body.setAwake(true);
            b.body.setAwake(true);
          }
        }
      for (const o of list) this.contain(o);
    }
  }
  snapshot() {
    return [...this.orbs.values()].map((o) => ({
      id: o.id,
      tier: o.tier,
      x: o.body.getPosition().x * PX,
      y: o.body.getPosition().y * PX,
      vx: o.body.getLinearVelocity().x * PX,
      vy: o.body.getLinearVelocity().y * PX,
      r: o.radius,
      feed: o.feed,
    }));
  }
}

import { Project, PX } from "./config";
import { Simulation, SimEvent, boundary } from "./physics";
import { AssetLibrary } from "./assets";
export class Renderer {
  ctx: CanvasRenderingContext2D;
  effects: (SimEvent & { at: number; seed: number })[] = [];
  private wallCanvas = document.createElement("canvas");
  private signature = "";
  constructor(
    public canvas: HTMLCanvasElement,
    public assets: AssetLibrary,
    public width = 720,
  ) {
    this.ctx = canvas.getContext("2d", { alpha: false })!;
    canvas.width = width;
    canvas.height = (width * 16) / 9;
    this.wallCanvas.width = width;
    this.wallCanvas.height = canvas.height;
    this.ctx.scale(width / 720, width / 720);
    this.ctx.imageSmoothingQuality = "high";
    this.wallCanvas.getContext("2d")!.scale(width / 720, width / 720);
  }
  event(e: SimEvent, time: number) {
    if (e.kind === "merge")
      this.effects.push({
        ...e,
        at: time,
        seed: this.effects.length * 3.7 + time,
      });
  }
  wall(p: Project) {
    const s = p.settings,
      sig = JSON.stringify([
        s.chamberX,
        s.chamberY,
        s.chamberRadius,
        s.chuteWidth,
        s.outline,
        s.outlineColorA,
        s.outlineColorB,
      ]);
    if (sig === this.signature) return;
    this.signature = sig;
    const c = this.wallCanvas.getContext("2d")!;
    c.clearRect(0, 0, 720, 1280);
    const pts = boundary(p),
      g = c.createLinearGradient(s.chamberX - 1, 0, s.chamberX + 1, 0);
    // Two solid halves, including the chute: no third rainbow hues.
    g.addColorStop(0, s.outlineColorA);
    g.addColorStop(0.5, s.outlineColorA);
    g.addColorStop(0.5, s.outlineColorB);
    g.addColorStop(1, s.outlineColorB);
    c.strokeStyle = g;
    c.lineWidth = s.outline;
    c.lineJoin = "round";
    c.lineCap = "round";
    c.beginPath();
    pts.forEach((p, i) => (i ? c.lineTo(p.x, p.y) : c.moveTo(p.x, p.y)));
    c.stroke();
  }

  draw(sim: Simulation, alpha = 1) {
    const c = this.ctx,
      p = sim.project,
      s = p.settings;
    c.fillStyle = "#000";
    c.fillRect(0, 0, 720, 1280);
    this.wall(p);
    for (const o of sim.orbs.values()) {
      const t = p.tiers[o.tier],
        im = this.assets.images.get(t.image);
      if (!im) continue;
      const pos = o.body.getPosition(),
        x = o.previous.x + (pos.x * PX - o.previous.x) * alpha,
        y = o.previous.y + (pos.y * PX - o.previous.y) * alpha,
        angle = s.rotateSprites
          ? o.previousAngle + (o.body.getAngle() - o.previousAngle) * alpha
          : 0,
        size = o.radius * 2 * t.imageFit,
        ratio = im.naturalWidth / im.naturalHeight,
        w = ratio >= 1 ? size : size * ratio,
        h = ratio >= 1 ? size / ratio : size;
      c.save();
      c.translate(x, y);
      c.rotate(angle);
      if (t.crop) {
        c.beginPath();
        c.arc(0, 0, o.radius, 0, Math.PI * 2);
        c.clip();
      }
      if (s.glow > 0) {
        c.shadowColor = `rgba(255,219,155,${s.glow})`;
        c.shadowBlur = ((14 + o.radius * 0.1) * this.width) / 720;
      }
      c.drawImage(
        im,
        t.offsetX * t.scale - w / 2,
        t.offsetY * t.scale - h / 2,
        w,
        h,
      );
      c.restore();
    }
    c.drawImage(this.wallCanvas, 0, 0, 720, 1280);
    this.effects = this.effects.filter(
      (e) => sim.time - e.at < s.duration * (1 + Math.max(0, e.a - 3) * 0.3),
    );
    for (const raw of this.effects) {
      const e = {
        ...raw,
        x: raw.x + p.tiers[raw.a].offsetX * p.tiers[raw.a].scale,
        y: raw.y + p.tiers[raw.a].offsetY * p.tiers[raw.a].scale,
      };
      const age =
          (sim.time - e.at) / (s.duration * (1 + Math.max(0, e.a - 3) * 0.3)),
        k = Math.max(0, 1 - age),
        r = e.radius * (1.5 + age * 3);
      c.save();
      if (age < 0.22 && s.glow > 0) {
        const g = c.createRadialGradient(e.x, e.y, 0, e.x, e.y, e.radius * 1.2);
        g.addColorStop(
          0,
          `rgba(255,255,240,${(1 - age / 0.22) * Math.min(1, s.glow * 2.2)})`,
        );
        g.addColorStop(1, "transparent");
        c.fillStyle = g;
        c.fillRect(
          e.x - e.radius * 1.2,
          e.y - e.radius * 1.2,
          e.radius * 2.4,
          e.radius * 2.4,
        );
      }
      for (let i = 0; i < s.rings; i++) {
        c.strokeStyle = `rgba(255,255,246,${(k * 0.9) / (i + 1)})`;
        c.lineWidth = 1.4;
        c.shadowBlur = (7 * this.width) / 720;
        c.shadowColor = "#ffffdd";
        c.beginPath();
        c.arc(e.x, e.y, r * (1 + i * 0.22), 0, Math.PI * 2);
        c.stroke();
      }
      c.shadowBlur = (7 * this.width) / 720;
      for (
        let i = 0;
        i < Math.round(s.particles * (0.7 + e.radius / 70));
        i++
      ) {
        const angle = i * 2.399 + e.seed,
          d = i % 2 ? r : e.radius * (0.5 + age * (1.2 + (i % 4) * 0.15)),
          x = e.x + Math.cos(angle) * d,
          y = e.y + Math.sin(angle) * d + age * age * 10;
        c.globalAlpha = k * k;
        c.fillStyle = i % 4 ? "#fffce4" : "#ffc86c";
        c.beginPath();
        c.arc(x, y, (i % 3 ? 2.1 : 3.3) * (0.5 + k * 0.5), 0, Math.PI * 2);
        c.fill();
      }
      c.restore();
    }
    if (s.showUsername && s.username.trim()) {
      c.save();
      c.font = "700 26px Arial, sans-serif";
      c.textAlign = "center";
      c.textBaseline = "middle";
      c.fillStyle = "rgba(255,255,255,0.2)";
      c.fillText(
        s.username.trim(),
        s.chamberX,
        s.chamberY,
        s.chamberRadius * 1.5,
      );
      c.restore();
    }
  }
}

:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  color: #e8e6ef;
  background: #101014;
  color-scheme: dark;
  font-size: 14px;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
button,
input,
select {
  font: inherit;
}
button,
.file-button {
  background: #25242d;
  border: 1px solid #3a3745;
  color: #e8e6ef;
  border-radius: 8px;
  padding: 10px 13px;
  cursor: pointer;
  text-align: center;
  transition:
    background 0.15s,
    border-color 0.15s;
}
button:hover,
.file-button:hover {
  background: #35313f;
  border-color: #82728f;
}
button:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}
button:focus-visible,
input:focus-visible,
summary:focus-visible,
.file-button:focus-within {
  outline: 2px solid #c5abf9;
  outline-offset: 3px;
}
.primary {
  background: #ccb7f3;
  border-color: #ccb7f3;
  color: #21172e;
  font-weight: 650;
}
.primary:hover {
  background: #ddc9ff;
}
.full {
  width: 100%;
  margin-top: 12px;
}
main {
  display: grid;
  grid-template-columns: minmax(370px, 1fr) 440px;
  max-width: 1440px;
  margin: auto;
  min-height: 100vh;
}
.stage {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 25px 30px;
  background: radial-gradient(ellipse at center, #1c1b24, #111115 70%);
}
.stage-meta,
.stage-foot {
  width: min(100%, calc((100vh - 104px) * 0.5625));
  display: flex;
  gap: 9px;
  align-items: center;
  font-size: 10px;
  letter-spacing: 1.6px;
  color: #85818e;
}
.stage-meta {
  justify-content: space-between;
  margin-bottom: 14px;
}
.stage-foot {
  margin-top: 14px;
  letter-spacing: 0.6px;
}
.stage-foot > span:last-child {
  margin-left: auto;
}
.portrait {
  height: calc(100vh - 104px);
  max-width: 100%;
  aspect-ratio: 9/16;
  background: black;
  box-shadow: 0 15px 70px #0008;
  overflow: hidden;
}
canvas {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  outline: none;
}
.dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #b5e3b7;
  box-shadow: 0 0 8px #b5e3b744;
}
aside {
  border-left: 1px solid #29262f;
  padding: 32px 26px;
  background: #18171d;
}
header .eyebrow {
  font-size: 10px;
  font-weight: 650;
  letter-spacing: 2px;
  color: #a7a0b2;
  display: flex;
  gap: 8px;
  align-items: center;
}
h1 {
  font-size: 29px;
  letter-spacing: -1.1px;
  margin: 16px 0 7px;
  font-weight: 600;
}
h1 span {
  font-size: 27px;
  float: right;
  color: #b7a4d5;
}
header p {
  font-size: 13px;
  color: #938c9e;
  margin: 0 0 25px;
}
.transport {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 7px;
}
.transport #clean {
  grid-column: 1/-1;
  background: transparent;
  color: #c0b4cf;
}
.audio-unlock {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 15px 0 9px;
}
.audio-unlock button {
  padding: 8px;
  font-size: 12px;
  color: #d3b9ff;
  border-color: #574369;
  background: #2b2235;
}
.audio-unlock span {
  font-size: 11px;
  color: #a69caf;
}
.audio-unlock.enabled {
  display: none;
