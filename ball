(async () => {
  const browser = await chromium.launch({
    executablePath: process.env.CHROME_PATH || undefined,
    headless: true,
  });
  const page = await browser.newPage({
    viewport: { width: 1000, height: 900 },
  });
  await page.goto(
    (process.env.BASE_URL || "http://127.0.0.1:5173") + "/?test=1",
  );
  await page.waitForFunction(() => window.__sim);
  const result = await page.evaluate(async () => {
    const qa = __sim;
    qa.reset(false);
    qa.app.project.tiers = qa.app.project.tiers.slice(0, 1);
    qa.app.project.tiers[0].radius = 20;
    qa.app.reset(false);
    qa.app.running = false;
    for (let y = 340; y < 850; y += 42)
      for (let x = 190; x < 550; x += 42)
        if (Math.hypot(x - 360, y - 586) < 260) qa.sim.add(0, x, y);
    qa.step(900, false);
    const times = [],
      physics = [],
      render = [];
    for (let i = 0; i < 120; i++) {
      const start = performance.now();
      qa.sim.step(false);
      qa.sim.step(false);
      const split = performance.now();
      qa.renderer.draw(qa.sim);
      physics.push(split - start);
      render.push(performance.now() - split);
      times.push(performance.now() - start);
    }
    const a = qa.snapshot();
    let overlap = 0,
      worst = [];
    for (let i = 0; i < a.length; i++)
