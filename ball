export class AssetLibrary {
  images = new Map<string, HTMLImageElement>();
  urls = new Map<string, string>();
  async image(key: string, assets: Record<string, Blob>) {
    if (this.images.has(key)) return this.images.get(key)!;
    const src = key.startsWith("builtin:")
      ? `./assets/${key.slice(8)}.png`
      : this.url(key, assets);
    if (!src) throw Error(`Missing image: ${key}`);
    const im = new Image();
    im.src = src;
    await im.decode();
    if (im.naturalWidth > 8192 || im.naturalHeight > 8192)
      throw Error("Images must be at most 8192 × 8192 pixels.");
    this.images.set(key, im);
    return im;
  }
  url(key: string, assets: Record<string, Blob>) {
    if (!assets[key]) return "";
    if (!this.urls.has(key))
      this.urls.set(key, URL.createObjectURL(assets[key]));
    return this.urls.get(key)!;
  }
  async preload(p: Project) {
    await Promise.all(p.tiers.map((t) => this.image(t.image, p.assets)));
  }
  clear() {
    for (const u of this.urls.values()) URL.revokeObjectURL(u);
    this.urls.clear();
    this.images.clear();
  }
}
function database(): Promise<IDBDatabase> {
  return new Promise((resolve, reject) => {
    const r = indexedDB.open("merge-chamber-studio", 1);
    r.onupgradeneeded = () => r.result.createObjectStore("projects");
    r.onsuccess = () => resolve(r.result);
    r.onerror = () => reject(r.error);
  });
}
export function compactProject(p: Project) {
  const used = new Set([
    ...p.tiers.flatMap((t) => [t.image, t.sound, t.creationSound]),
    p.settings.collisionSound,
    p.settings.mergeSound,
    p.settings.wallSound,
  ]);
  return {
    ...p,
    assets: Object.fromEntries(
      Object.entries(p.assets).filter(([id]) => used.has(id)),
    ),
  };
}
export async function save(p: Project) {
  const db = await database();
  try {
    await new Promise<void>((resolve, reject) => {
      const t = db.transaction("projects", "readwrite");
      t.objectStore("projects").put(
        structuredClone(compactProject(p)),
        "current",
      );
      t.oncomplete = () => resolve();
      t.onerror = () => reject(t.error);
    });
  } finally {
    db.close();
  }
}
export async function load(): Promise<Project> {
  const db = await database();
  try {
    return await new Promise((resolve, reject) => {
      const r = db
        .transaction("projects")
        .objectStore("projects")
        .get("current");
      r.onsuccess = () => {
        try {
          resolve(r.result ? validate(r.result) : defaults());
        } catch (e) {
          reject(e);
        }
      };
      r.onerror = () => reject(r.error);
    });
  } finally {
    db.close();
  }
}
const mimeExt = (type: string) =>
  type.includes("png")
    ? "png"
    : type.includes("webp")
      ? "webp"
      : type.includes("jpeg")
        ? "jpg"
        : type.includes("wav")
          ? "wav"
          : type.includes("mpeg")
            ? "mp3"
            : type.includes("ogg")
              ? "ogg"
              : "bin";
export async function exportProject(p: Project) {
  const z = new JSZip(),
    copy = structuredClone(compactProject(p)),
    manifest: Record<string, { path: string; type: string }> = {};
  let n = 0;
  for (const [id, blob] of Object.entries(copy.assets)) {
    const path = `assets/${n++}.${mimeExt(blob.type)}`;
    z.file(path, await blob.arrayBuffer());
    manifest[id] = { path, type: blob.type };
  }
  // Include original bytes of built-in images too, so an archive is self-contained.
  for (const t of copy.tiers)
    if (t.image.startsWith("builtin:")) {
      const key = t.image;
      if (!manifest[key]) {
        const blob = await (await fetch(`./assets/${key.slice(8)}.png`)).blob(),
          path = `assets/${n++}.png`;
        z.file(path, await blob.arrayBuffer());
        manifest[key] = { path, type: "image/png" };
      }
    }
  // Built-in sounds are portable synthesis recipes; export actual PCM WAV files.
  for (const key of ["builtin:collision", "builtin:merge", "builtin:wall"]) {
    const blob = placeholderWav(key),
      path = `assets/${n++}.wav`;
    z.file(path, await blob.arrayBuffer());
    manifest[key] = { path, type: "audio/wav" };
  }
  z.file(
    "project.json",
    JSON.stringify(
      {
        version: 1,
        tiers: copy.tiers,
        settings: copy.settings,
        video: copy.video,
        assets: manifest,
      },
      null,
      2,
    ),
  );
  return z.generateAsync({ type: "blob", compression: "DEFLATE" });
}
export async function importProject(file: File) {
  if (file.size > 100 * 1024 * 1024)
    throw Error("Project exceeds the 100 MB limit.");
  let z: JSZip;
  try {
    z = await JSZip.loadAsync(file);
  } catch {
    throw Error("This is not a valid .merge.zip archive.");
  }
  const entry = z.file("project.json");
  if (!entry) throw Error("Archive is missing project.json.");
  const manifestText = await entry.async("string");
  if (manifestText.length > 2e6) throw Error("Manifest is too large.");
  let p: any;
  try {
    p = JSON.parse(manifestText);
  } catch {
    throw Error("project.json contains invalid JSON.");
  }
  validate(p);
  const data: Record<string, Blob> = {};
  let total = 0;
  if (
    !p.assets ||
    typeof p.assets !== "object" ||
    Object.keys(p.assets).length > 100
  )
    throw Error("Invalid asset manifest.");
  for (const [key, v] of Object.entries(p.assets) as [string, any][]) {
    if (
      !v ||
      typeof v.path !== "string" ||
      !v.path.startsWith("assets/") ||
      v.path.includes("..") ||
      typeof v.type !== "string"
    )
      throw Error("Invalid asset entry.");
    const f = z.file(v.path);
    if (!f) throw Error(`Missing asset file: ${v.path}`);
    const estimated = (f as any)._data?.uncompressedSize;
    if (estimated > 25 * 1024 * 1024) throw Error("An asset exceeds 25 MB.");
    const bytes = await f.async("uint8array");
    total += bytes.length;
    if (total > 150 * 1024 * 1024)
      throw Error("Expanded project exceeds 150 MB.");
    data[key] = new Blob([bytes as BlobPart], { type: v.type });
  }
  for (const key of [
    ...p.tiers.flatMap((t: any) => [t.image, t.sound, t.creationSound]),
    p.settings.collisionSound,
    p.settings.mergeSound,
    p.settings.wallSound,
  ].filter(Boolean))
    if (!data[key] && !key.startsWith("builtin:"))
      throw Error(`Missing asset: ${key}`);
  // Remap built-ins to imported bytes, not bundled defaults.
  const remap = (key: string) =>
    data[key] && key.startsWith("builtin:") ? `imported:${key}` : key;
  for (const key of Object.keys(data))
    if (key.startsWith("builtin:")) {
      data[remap(key)] = data[key];
      delete data[key];
    }
  for (const t of p.tiers) {
    if (t.image.startsWith("builtin:")) t.image = `imported:${t.image}`;
    if (t.sound.startsWith("builtin:")) t.sound = `imported:${t.sound}`;
    if (t.creationSound.startsWith("builtin:"))
      t.creationSound = `imported:${t.creationSound}`;
  }
  for (const k of ["collisionSound", "mergeSound", "wallSound"])
    if (p.settings[k].startsWith("builtin:"))
      p.settings[k] = `imported:${p.settings[k]}`;
  p.assets = data;
  return p as Project;
}
export function placeholderWav(key: string) {
  const rate = 22050,
    duration = key.includes("merge") ? 0.26 : 0.1,
    n = Math.ceil(rate * duration),
    buffer = new ArrayBuffer(44 + n * 2),
    v = new DataView(buffer);
  const text = (off: number, s: string) =>
    [...s].forEach((c, i) => v.setUint8(off + i, c.charCodeAt(0)));
  text(0, "RIFF");
  v.setUint32(4, 36 + n * 2, true);
  text(8, "WAVEfmt ");
  v.setUint32(16, 16, true);
  v.setUint16(20, 1, true);
  v.setUint16(22, 1, true);
  v.setUint32(24, rate, true);
  v.setUint32(28, rate * 2, true);
  v.setUint16(32, 2, true);
  v.setUint16(34, 16, true);
  text(36, "data");
  v.setUint32(40, n * 2, true);
  for (let i = 0; i < n; i++) {
    const t = i / rate,
      merge = key.includes("merge"),
      freq = merge ? 650 : key.includes("wall") ? 180 : 400;
    const wave =
      Math.sin(2 * Math.PI * (freq * t + (merge ? 900 : -800) * t * t)) * 0.6 +
      Math.sin(2 * Math.PI * freq * 1.5 * t) * 0.18;
    const env = Math.min(1, t / 0.004) * Math.exp(-t / (merge ? 0.065 : 0.025));
    v.setInt16(
      44 + i * 2,
      Math.max(-32767, Math.min(32767, wave * env * 24000)),
      true,
    );
  }
  return new Blob([buffer], { type: "audio/wav" });
}

import { Project } from "./config";
import { placeholderWav } from "./assets";
import { SimEvent } from "./physics";
export class SoundEngine {
  context: AudioContext | null = null;
  buffers = new Map<string, AudioBuffer>();
  active = new Set<AudioBufferSourceNode>();
  last = new Map<string, number>();
  played = { collision: 0, merge: 0, wall: 0, spawn: 0 };
  unlocked = false;
  async init(p: Project) {
    if (!this.context) this.context = new AudioContext();
    await this.preload(p);
  }
  async unlock(p: Project) {
    await this.init(p);
    await this.context!.resume();
    this.unlocked = true;
  }
  async decode(key: string, blob: Blob) {
    if (blob.size > 20 * 1024 * 1024)
      throw Error("Sound files must be smaller than 20 MB.");
    if (!this.context) this.context = new AudioContext();
    let b: AudioBuffer;
    try {
      b = await this.context.decodeAudioData(await blob.arrayBuffer());
    } catch {
      throw Error(
        "This audio format could not be decoded. Try WAV, MP3, OGG, or M4A.",
      );
    }
    if (b.duration > 30) throw Error("Use a sound shorter than 30 seconds.");
    this.buffers.set(key, b);
    return b;
  }
  async preload(p: Project) {
    const ids = new Set(
      [
        p.settings.collisionSound,
        p.settings.mergeSound,
        p.settings.wallSound,
        ...p.tiers.flatMap((t) => [t.sound, t.creationSound]),
      ].filter(Boolean),
    );
    await Promise.all(
      [...ids].map(async (k) => {
        if (!this.buffers.has(k)) {
          const blob = k.startsWith("builtin:")
            ? placeholderWav(k)
            : p.assets[k];
          if (!blob) throw Error(`Missing sound: ${k}`);
          await this.decode(k, blob);
        }
      }),
    );
  }
  stop() {
    for (const n of this.active)
      try {
        n.stop();
      } catch {}
    this.active.clear();
  }
  play(key: string, volume: number, p: Project) {
    const c = this.context,
      s = p.settings,
      b = this.buffers.get(key);
    if (
      !c ||
      !this.unlocked ||
      c.state !== "running" ||
      s.muted ||
      !b ||
      this.active.size >= s.voices
    )
      return false;
    const source = c.createBufferSource(),
      gain = c.createGain();
    source.buffer = b;
    gain.gain.value = Math.min(1, volume * s.master);
    source.connect(gain).connect(c.destination);
    this.active.add(source);
    source.onended = () => {
      this.active.delete(source);
      source.disconnect();
      gain.disconnect();
    };
    source.start();
    return true;
  }
  handle(e: SimEvent, p: Project, time: number) {
    const sound = selectSound(e, p, time, this.last);
    if (!sound) return;
    const { key, volume } = sound;
    if (this.play(key, volume, p)) this.played[e.kind]++;
  }
}

// Shared event routing for live playback and deterministic video audio.
export function selectSound(
  e: SimEvent,
  p: Project,
  time: number,
  last: Map<string, number>,
) {
  const s = p.settings;
  const creation = e.kind === "merge" || e.kind === "spawn";
  if (!creation && e.speed < s.threshold) return null;
  if (time - (last.get(e.pair) ?? -Infinity) < s.cooldown) return null;
  last.set(e.pair, time);
  if (last.size > 2000)
    for (const [k, t] of last) if (time - t > 3) last.delete(k);
  const tier = p.tiers[Math.max(e.a, e.b ?? e.a)];
  const key =
    e.kind === "merge"
      ? tier.creationSound || s.mergeSound
      : e.kind === "spawn"
        ? tier.creationSound
        : e.kind === "wall"
          ? s.wallSound
          : tier.sound || s.collisionSound;
  const volume =
    (creation
      ? s.mergeVolume
      : e.kind === "wall"
        ? s.wallVolume
        : s.collisionVolume) *
    (creation ? 1 : Math.max(0.18, Math.min(1, e.speed / 300)));
  return { key, volume };
}

import type { Settings } from "./config";

/** Closest point on the actual open arc and the two chute rays. The removed
 * top arc is never a collision surface, including for a disk near a shoulder. */
export function wallClearance(s: Settings, x: number, y: number) {
  const dx = x - s.chamberX,
    dy = y - s.chamberY;
  const half = s.chuteWidth / 2,
    radius = s.chamberRadius;
  const join = s.chamberY - Math.sqrt(radius * radius - half * half);
  const distance = Math.hypot(dx, dy);
  const candidates: { x: number; y: number; ix: number; iy: number }[] = [];
  for (const side of [-1, 1])
    candidates.push({
      x: s.chamberX + side * half,
      y: Math.min(y, join),
      ix: -side,
      iy: 0,
    });
  const rx = distance ? dx / distance : 0,
    ry = distance ? dy / distance : 1;
  // A radial projection is valid only when it lands on the solid arc.
  if (ry * radius >= join - s.chamberY || Math.abs(rx * radius) >= half)
    candidates.push({
      x: s.chamberX + rx * radius,
      y: s.chamberY + ry * radius,
      ix: -rx,
      iy: -ry,
    });
  let nearest = candidates[0],
    best = Infinity;
  for (const point of candidates) {
    const d = Math.hypot(x - point.x, y - point.y);
    if (d < best) {
      best = d;
      nearest = point;
    }
  }
  const inside = distance <= radius || (Math.abs(dx) <= half && y <= join);
  const ix = inside && best > 1e-9 ? (x - nearest.x) / best : nearest.ix;
  const iy = inside && best > 1e-9 ? (y - nearest.y) / best : nearest.iy;
  return { distance: inside ? best : -best, ix, iy, join };
}

export function projectInside(
  s: Settings,
  x: number,
  y: number,
  radius: number,
) {
  const clearance = radius + 0.3;
  const half = s.chuteWidth / 2;
  const join = s.chamberY - Math.sqrt(s.chamberRadius ** 2 - half ** 2);
  // A newly grown disk wider than the neck has to clear both shoulder endpoints.
  if (clearance >= half && y < join + clearance) {
    const sideGap = Math.max(0, half - Math.abs(x - s.chamberX));
    y = Math.max(
      y,
      join + Math.sqrt(Math.max(0, clearance ** 2 - sideGap ** 2)),
    );
  }
  for (let i = 0; i < 6; i++) {
    const wall = wallClearance(s, x, y);
    const penetration = clearance - wall.distance;
    if (penetration < 1e-7) break;
    x += wall.ix * penetration;
    y += wall.iy * penetration;
  }
  return { x, y };
}

