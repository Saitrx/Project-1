    !p ||
    p.version !== 1 ||
    !Array.isArray(p.tiers) ||
    p.tiers.length < 1 ||
    p.tiers.length > 24
  )
    throw Error("A project needs version 1 and between 1 and 24 tiers.");
  if (p.video === undefined) p.video = videoDefaults();
  validateVideo(p.video);
  if (!p.settings) throw Error("Project settings are missing.");
  if (p.settings.username === undefined)
    p.settings.username = "@povanimationsim";
  if (p.settings.showUsername === undefined) p.settings.showUsername = true;
  if (
    typeof p.settings.username !== "string" ||
    p.settings.username.length > 60 ||
    typeof p.settings.showUsername !== "boolean"
  )
    throw Error(
      "Username must be 60 characters or fewer, with a valid show/hide setting.",
    );
  if (p.settings.rotateSprites === undefined) p.settings.rotateSprites = true;
  if (p.settings.maxSpin === undefined) p.settings.maxSpin = 120;
  if (p.settings.angularDamping === undefined) p.settings.angularDamping = 0.12;
  if (typeof p.settings.rotateSprites !== "boolean")
    throw Error("Invalid picture rotation setting.");
  if (p.settings.outlineColorA === undefined)
    p.settings.outlineColorA = "#ac6cff";
  if (p.settings.outlineColorB === undefined)
    p.settings.outlineColorB = "#65ffd1";
  for (const key of ["outlineColorA", "outlineColorB"] as const)
    if (
      typeof p.settings[key] !== "string" ||
      !/^#[0-9a-f]{6}$/i.test(p.settings[key])
    )
      throw Error("Outline colors must be six-digit hex colors.");
  // Migrate saved setups from before independent wall bounce and tier creation audio.
  if (p.settings.wallBounce === undefined) p.settings.wallBounce = 0.98;
  if (p.settings.expansionBounce === undefined)
    p.settings.expansionBounce = 1.5;
  // Retain legacy fields for project compatibility; sprite shake was removed.
  p.settings.shake = 0;
  if (p.settings.shakeDuration === undefined) p.settings.shakeDuration = 0.42;
  for (const [k, [min, max]] of Object.entries(limits)) {
    const v = (p.settings as any)[k];
    if (typeof v !== "number" || !Number.isFinite(v) || v < min || v > max)
      throw Error(`Invalid ${k}: expected ${min}–${max}.`);
  }
  const ids = new Set();
  for (const t of p.tiers) {
    // Old scale meant visual fit only. Preserve old pictures and collider sizes.
    if (t.imageFit === undefined) {
      t.imageFit = t.scale;
      t.scale = 1;
    }
    if (t.creationSound === undefined) t.creationSound = "";
    if (
      typeof t.id !== "string" ||
      !/^[-a-zA-Z0-9_]{1,100}$/.test(t.id) ||
      ids.has(t.id)
    )
      throw Error("Tier IDs must be unique.");
    ids.add(t.id);
    if (typeof t.name !== "string" || t.name.length > 80)
      throw Error("Tier names must be 80 characters or fewer.");
    for (const [key, min, max] of [
      ["radius", 8, 220],
      ["scale", 1 / 32, 32],
      ["imageFit", 0.25, 3],
      ["offsetX", -150, 150],
      ["offsetY", -150, 150],
    ] as const)
      if (!Number.isFinite(t[key]) || t[key] < min || t[key] > max)
        throw Error(`Invalid ${t.name} ${key}.`);
    if (
      typeof t.crop !== "boolean" ||
      typeof t.image !== "string" ||
      typeof t.sound !== "string" ||
      typeof t.creationSound !== "string"
    )
      throw Error("Invalid tier asset or crop setting.");
  }
  if (p.tiers.some((t) => tierRadius(t) < 8 || tierRadius(t) > 220))
    throw Error(
      "Picture size × base radius must give a hitbox radius between 8 and 220 px.",
    );
  if (tierRadius(p.tiers[0]) * 2 + 6 > p.settings.chuteWidth)
    throw Error(
      "The first tier must fit through the chute (with 6 px clearance).",
    );
  if (p.tiers.some((t) => tierRadius(t) > p.settings.chamberRadius * 0.7))
    throw Error("A tier radius exceeds 70% of the chamber radius.");
  if (
    p.settings.chamberX - p.settings.chamberRadius < 2 ||
    p.settings.chamberX + p.settings.chamberRadius > 718 ||
    p.settings.chamberY + p.settings.chamberRadius > 1200
  )
    throw Error("The chamber must fit inside the portrait.");
  if (typeof p.settings.muted !== "boolean")
    throw Error("Invalid mute setting.");
  for (const k of ["collisionSound", "mergeSound", "wallSound"] as const)
    if (typeof p.settings[k] !== "string") throw Error(`Invalid ${k}.`);
  return p;
}

